# Google Gemini (Developer 1 — agents / generation / news analysis)
# Used by @google/genai and Mastra's google model router.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional alias also accepted by Mastra:
# GOOGLE_API_KEY=
# Optional model override (app default: gemini-3.1-flash-lite).
# If free-tier quota on one model is exhausted, generateJson retries alternates.
GEMINI_MODEL=

# Bright Data (Developer 1 — news / research)
# Create a SERP API zone in Bright Data control panel, then paste values here.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=
# Optional: Web Unlocker zone for full article markdown fetches
BRIGHT_DATA_UNLOCKER_ZONE=

# ElevenLabs (Developer 2 — TTS / STT)
ELEVENLABS_API_KEY=

# Neon PostgreSQL (shared — optional for MVP; in-memory sessions work without it)
DATABASE_URL=
